{
  "name": "race-administration-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/build-canvas-core.cjs",
    "prebuild": "node ../scripts/build-canvas-core.cjs",
    "pretypecheck": "node ../scripts/build-canvas-core.cjs",
    "pretest": "node ../scripts/build-canvas-core.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run calendar:build && playwright test",
    "calendar:build": "tsc -p tsconfig.calendar-gate.json && vite build --config calendar-gate.config.ts"
  },
  "dependencies": {
    "antd": "6.6.5",
    "dayjs": "1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
